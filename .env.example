# Base URL of the Qonics internship API. Leave empty to run on labelled demo data (no backend).
NUXT_PUBLIC_API_BASE=

# PrimeVue 5 license key (PrimeUI License). Without it the dev UI shows an "Invalid PrimeUI License" badge.
NUXT_PUBLIC_PRIMEUI_LICENSE=

# Public contact inbox shown on /contact
NUXT_PUBLIC_CONTACT_EMAIL=internships@qonics.example
